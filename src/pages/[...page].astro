---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'
import { themeConfig } from '~/.config'
import Pagination from '~/components/Pagination.astro'
import PostMeta from '~/components/PostMeta.astro'
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import { getPostDescription, getPosts } from '~/utils'

const { translate: t } = Astro.locals

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts()
  posts.sort((a, b) => {
    if (a.data.pin && !b.data.pin) return -1
    if (!a.data.pin && b.data.pin) return 1
    return 0
  })
  return paginate(posts, { pageSize: themeConfig.site.pageSize })
}) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { page } = Astro.props
const { hero } = themeConfig.site

// The hero belongs to the front page only, not to /2, /3 …
const showHero = Boolean(hero) && page.currentPage === 1
---

<LayoutDefault>
  {
    showHero && (
      <section class="shell">
        <div class="constrained hero">
          <h1>{hero!.title}</h1>
          {hero!.description && <p>{hero!.description}</p>}
        </div>
      </section>
    )
  }

  <div class="shell constrained">
    <section class="entries" style={showHero ? undefined : 'padding-top: var(--sp-50)'}>
      {
        page.data.map((post) => (
          <article>
            <PostMeta post={post} />
            <p class="entry__excerpt">{getPostDescription(post)}</p>
          </article>
        ))
      }
    </section>

    <Pagination
      showLeft={Boolean(page.url.prev)}
      leftTitle={t('prev')}
      leftUrl={page.url.prev}
      showRight={Boolean(page.url.next)}
      rightTitle={t('next')}
      rightUrl={page.url.next}
      currentPage={page.currentPage}
      totalPage={page.lastPage}
    />
  </div>
</LayoutDefault>
