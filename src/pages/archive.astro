---
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import type { Post } from '~/types'
import { formatDate, getPosts } from '~/utils'

const { translate: t } = Astro.locals
const posts = await getPosts(true)
const yearMap = getYearMap(posts)

interface ListItem {
  title: string
  href: string
  date: string
}

function getYearMap(posts: Post[]) {
  const result = new Map<number, ListItem[]>()
  for (const post of posts) {
    const year = (post.data.pubDate ?? new Date()).getFullYear()
    const list = result.get(year) ?? []
    list.push({
      title: post.data.title,
      href: `/posts/${post.id}/`,
      date: formatDate(post.data.pubDate, 'MMM D'),
    })
    result.set(year, list)
  }
  return Array.from(result.entries())
}
---

<LayoutDefault>
  <div class="shell constrained">
    <header class="post-header">
      <h1>{t('Archive')}</h1>
    </header>

    <div class="year-group" style="padding-bottom: var(--sp-40)">
      {
        yearMap.map(([year, items]) => (
          <section class="year-group">
            <h2>{year}</h2>
            <ul class="list-plain">
              {items.map(({ title, href, date }) => (
                <li class="list-row">
                  <time>{date}</time>
                  <a href={href}>{title}</a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</LayoutDefault>
