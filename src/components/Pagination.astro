---
const { translate: t } = Astro.locals

interface Props {
  showLeft?: boolean
  leftTitle?: string
  leftUrl?: string
  showRight?: boolean
  rightTitle?: string
  rightUrl?: string
  showPageCount?: boolean
  currentPage?: number
  totalPage?: number
}

const {
  showLeft = true,
  showRight = true,
  leftTitle,
  rightTitle,
  leftUrl,
  rightUrl,
  showPageCount = true,
  currentPage,
  totalPage,
} = Astro.props

const hasLinks = (showLeft && leftUrl) || (showRight && rightUrl)
---

{
  (hasLinks || showPageCount) && (
    <nav class="pagination" aria-label="Pagination">
      {showPageCount ? (
        <span class="pagination__count">
          {t('page_number', currentPage)} / {t('page_count', totalPage)}
        </span>
      ) : (
        <span />
      )}

      <div class="pagination__links">
        {showLeft && leftUrl && <a href={leftUrl}>&larr; {leftTitle}</a>}
        {showRight && rightUrl && <a href={rightUrl}>{rightTitle} &rarr;</a>}
      </div>
    </nav>
  )
}
