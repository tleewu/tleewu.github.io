---
import { themeConfig } from '~/.config'
import SocialIcon from '~/components/SocialIcon.astro'

const { navLinks, socialLinks } = themeConfig.site
const { translate: t } = Astro.locals

// Trailing-slash-insensitive compare so /archive and /archive/ both match.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/'

function isCurrent(href: string) {
  const target = href.replace(/\/+$/, '') || '/'
  return target === path
}
---

<nav class="site-nav" aria-label="Primary">
  <ul class="site-nav__links">
    {
      navLinks.map((nav) => (
        <li>
          <a href={nav.href} aria-current={isCurrent(nav.href) ? 'page' : undefined}>
            {t(nav.name)}
          </a>
        </li>
      ))
    }
  </ul>

  <ul class="site-nav__social">
    {
      socialLinks.map(({ href, name }) => (
        <li>
          <a href={href} title={name} rel="noopener" target={href.startsWith('http') ? '_blank' : undefined}>
            <SocialIcon name={name} />
            <span class="sr-only">{name}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
